# Curated supplements for adblock-rules.
# QX-syntax lines merged into the generated output, ahead of converted rules.
# Keep this file small and hand-checked: everything here is maintained by hand.
#
# --- gaps found by comparing with the AdRules jinx adapter ---
# jinx ships "wpad" (a bare single-label name, not a real domain) which our
# domain classifier rejects; add it back explicitly.
host, wpad, reject
# GDT SDK QUIC endpoint: AdRules blocks it, jinx has no "sdkquic.e.qq.com" entry.
host, sdkquic.e.qq.com, reject

# --- narrowed replacement for the dropped "ad*.*.*" wildcard ---
# The merged Shadowrocket module ships DOMAIN-WILDCARD,ad*.*.*,REJECT. Measured
# against the Tranco top 1M it also hits adidas.co.uk, adobe.co.jp,
# adelaide.edu.au, adm.gov.it and ~400 more real registrable domains, so it is
# dropped via wildcard_drop in config/sources.json. These prefixes keep the
# ad-subdomain coverage with real-world precision (26 top-1M hits, all ad-related).
host-wildcard, ads.*.*, reject
host-wildcard, adserver.*.*, reject
host-wildcard, adservice.*.*, reject
host-wildcard, adtech.*.*, reject
host-wildcard, adclick.*.*, reject
host-wildcard, adtrack.*.*, reject
host-wildcard, adzone.*.*, reject
host-wildcard, adx.*.*, reject
host-wildcard, adv.*.*, reject
host-wildcard, adnxs.*.*, reject
host-wildcard, adform.*.*, reject

# --- precision layer ported from the AdRules jinx adapter (shared_log_jinx.sgmodule) ---
# 9 ad-SDK hosts get connection-level DIRECT so SDK settings/stats keep working;
# only their ad endpoints are killed via the rewrite rules below (HTTPS needs MITM).
# These exact-direct entries also suppress the matching jinx blacklist entries
# during conversion (whitelist suppression), so no reject rule shadows them.
host, sdk.e.qq.com, direct
host, mi.gdt.qq.com, direct
host, v2mi.gdt.qq.com, direct
host, win.gdt.qq.com, direct
host, v.gdt.qq.com, direct
host, v3.gdt.qq.com, direct
host, api-access.pangolin-sdk-toutiao.com, direct
host, api-access.pangolin-sdk-toutiao1.com, direct
host, api-access.pangolin-sdk-toutiao-b.com, direct
# --- WeChat CDN false positives in third-party lists ---
# AWAvenue lists wxa/wximg/wxsmw.wxs.qq.com as ads, but all three resolve into
# Tencent's generic image CDN (cdn.dnsv1.com / legopic*.tdnsv6.com) and carry
# normal WeChat images, including the emoji panel. Blocking them makes WeChat
# retry every image load, which reads as "emoji search is slow". The genuinely
# ad-only siblings (wxsnsad/wxsnsdy/wxsnsdythumb) stay blocked.
# Whole-suffix release (wxs.qq.com) is deliberately NOT done here: that is a
# user-side choice, handled by subscribing to IMAiCool/AdGuardHome-rules.
host, wxa.wxs.qq.com, direct
host, wximg.wxs.qq.com, direct
host, wxsmw.wxs.qq.com, direct
# AdRules ALSO rejects these two UDP/QUIC-heavy hosts outright (its AND,NETWORK,UDP
# rules cannot be expressed in QX; whole-host reject is the closest equivalent).
host, webcast-open.douyin.com, reject
host, sdkquic.e.qq.com, reject
# GitHub must go through the user's proxy policy, not direct: these explicit
# direct entries (upstream whitelist) would shadow proxy rules that come later.
# Filter-output exclusion via OUTPUT_EXCLUDE below; direct entries removed here
# so the converter's whitelist does not carry them into jinx-adblock-qx.list.
# GDT/Pangle ad endpoints (AdRules uses reject-dict / reject-200 body rewrites;
# the dict/200 distinction is kept where AdRules had it). One regex per host so
# the converter can extract each hostname into jinx-mitm-required.txt.
^https?://api-access\.pangolin-sdk-toutiao\.com(?::\d+)?/api/ad/union/sdk/get_ads(?:\?|$) url reject-dict
^https?://api-access\.pangolin-sdk-toutiao1\.com(?::\d+)?/api/ad/union/sdk/get_ads(?:\?|$) url reject-dict
^https?://api-access\.pangolin-sdk-toutiao-b\.com(?::\d+)?/api/ad/union/sdk/get_ads(?:\?|$) url reject-dict
^https?://api-access\.pangolin-sdk-toutiao\.com(?::\d+)?/api/ad/union/server_bidding/pre_fetch(?:\?|$) url reject-200
^https?://api-access\.pangolin-sdk-toutiao1\.com(?::\d+)?/api/ad/union/server_bidding/pre_fetch(?:\?|$) url reject-200
^https?://api-access\.pangolin-sdk-toutiao-b\.com(?::\d+)?/api/ad/union/server_bidding/pre_fetch(?:\?|$) url reject-200
^https?://mi\.gdt\.qq\.com(?::\d+)?/gdt_mview\.fcg(?:\?|$) url reject-dict
^https?://v2mi\.gdt\.qq\.com(?::\d+)?/gdt_mview\.fcg(?:\?|$) url reject-dict
^https?://win\.gdt\.qq\.com(?::\d+)?/gdt_mview\.fcg(?:\?|$) url reject-dict
^https?://v\.gdt\.qq\.com(?::\d+)?/gdt_mview\.fcg(?:\?|$) url reject-dict
^https?://v3\.gdt\.qq\.com(?::\d+)?/gdt_mview\.fcg(?:\?|$) url reject-dict
